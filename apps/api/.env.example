# Copy to apps/api/.env. Loaded independent of the shell working directory.
# Use a direct/session-pooler connection with schema/table owner privileges.
# URL-encode special characters in the database password. Never commit the real URL.
WAYO_DATABASE_URL=postgresql+psycopg://postgres:password@127.0.0.1:5432/wayo
# Same project as the web client; use asymmetric ES256/RS256 JWT signing keys.
WAYO_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
