# Copy to apps/api/.env. Loaded independent of the shell working directory.
# Use a direct/session-pooler connection with schema/table owner privileges.
# URL-encode special characters in the database password. Never commit the real URL.
WAYO_DATABASE_URL=postgresql+psycopg://postgres:password@127.0.0.1:5432/wayo
# Same project as the web client; use asymmetric ES256/RS256 JWT signing keys.
WAYO_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# local | staging | production; deployed environments enforce PostgreSQL TLS + HTTPS Auth.
WAYO_ENVIRONMENT=local
# Server-only UUID allowlist, not user_metadata. Empty means no admin access.
WAYO_ADMIN_USER_IDS=[]
# External calls require explicit opt-in and credentials/endpoints. JSON arrays.
WAYO_PROVIDERS_ENABLED=[]
WAYO_PROVIDER_TIMEOUT_SECONDS=10
WAYO_PROVIDER_MAX_CALLS=10
# Optional: set only after provider qualification; never put secrets in these URLs.
# WAYO_ROUTING_BASE_URL=https://YOUR_OSRM_HOST
# WAYO_WEATHER_BASE_URL=https://api.open-meteo.com
# WAYO_LLM_API_KEY=YOUR_SERVER_ONLY_KEY
# WAYO_LLM_MODEL=YOUR_EXPLICIT_MODEL
WAYO_LLM_MAX_OUTPUT_TOKENS=512
