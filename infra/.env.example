# Copy outside source control; one distinct file/project/database per environment.
WAYO_ENVIRONMENT=local
WAYO_IMAGE_TAG=local
WAYO_WEB_PORT=3000
WAYO_DATABASE_URL=postgresql+psycopg://postgres:password@host.docker.internal:5432/wayo
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
WAYO_ADMIN_USER_IDS=[]
# For staging/production use a distinct DB with ?sslmode=require (or verify-full).
# Providers stay disabled in compose. Enable only after provider qualification.
